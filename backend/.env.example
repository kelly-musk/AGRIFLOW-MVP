DATABASE_URL=postgres://agriflow:agriflow@localhost:5432/agriflow
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24
SERVER_ADDR=0.0.0.0:8080
RUST_LOG=agriflow_api=debug,tower_http=debug,sqlx=warn

# Required to register an admin via POST /api/auth/register (sent as the
# X-Admin-Registration-Key header). Leave unset to disable admin signup.
ADMIN_REGISTRATION_KEY=

# Welcome emails via Resend (https://resend.com). Leave unset to skip sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend; the default test sender below only
# delivers to your own Resend account's address.
EMAIL_FROM=AgriFlow <onboarding@resend.dev>

# Bachs.io payment gateway (https://docs.bachs.io). Defaults below match the
# shared sandbox credentials already in the frontend's src/lib/bachs.ts --
# intentionally reusable team credentials, not per-deployment secrets, per
# the maintainer. Override any of these if that ever changes.
BACHS_SECRET_KEY=sk_sandbox_26a417c6_wjB3o7PUihDiKg3ms3yUeaFRJl3ZORJQaoPYqMtdbdw
BACHS_API_URL=https://sandbox-api.bachs.io/v1/checkout-sessions
# Verifies incoming webhook signatures (HMAC-SHA256, see src/bachs.rs) --
# must match whatever secret is configured on the Bachs webhook endpoint.
BACHS_WEBHOOK_SECRET=whsec_5cf64ff36a53cbb8e342b4e2bd204f63101c5800db9c1771ccba8adbd53265a3
